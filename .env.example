# Kafka (overrides config.yaml)
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC=snapshots

# Path to cameras list (default: cameras.yaml; used if backend cameras URL not set or fetch fails)
CAMERAS_CONFIG_PATH=cameras.yaml

# Fetch camera list from backend (GET returns JSON: { "cameras": [ {...} ] }). Overrides file when set.
# BACKEND_CAMERAS_URL=http://localhost:8000/api/cameras

# MinIO (optional: upload crops to MinIO, send only bucket+object_key in Kafka)
MINIO_ENABLED=false
MINIO_ENDPOINT=localhost:9000
MINIO_BUCKET=crops
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_SECURE=false

# RTSP
RTSP_USE_FFMPEG_PIPE=true

# Detection: person | face
DETECTION_TYPE=person
PERSON_MODEL_PATH=

# FPS
DEFAULT_FPS=2
# CAM1_FPS=2
# CAM2_FPS=1
