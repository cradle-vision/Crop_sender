# В Docker docker-compose подставляет это в SENDER_KAFKA_BOOTSTRAP_SERVERS.
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC=snapshots
KAFKA_JPEG_QUALITY=85

# Path to cameras list. Local: cameras.yaml. Docker: /app/config/cameras.yaml (file in ./config/)
CAMERAS_CONFIG_PATH=cameras.yaml

# Fetch camera list from backend (GET JSON: { "cameras": [...] } or { "items": [...] }).
# Auth: Bearer token — either set BACKEND_CAMERAS_TOKEN or use username/password to get token.
# BACKEND_CAMERAS_URL=http://localhost:8000/api/cameras
# BACKEND_CAMERAS_TOKEN=eyJhbGciOiJIUzI1NiIsInR5cCI6...
# Or login (POST /token) to get token automatically:
# BACKEND_TOKEN_URL=http://64.227.62.36:8009/token
# BACKEND_TOKEN_SCOPE=camera:read
BACKEND_CAMERAS_USERNAME=
BACKEND_CAMERAS_PASSWORD=

# MinIO (required: flow is crop → MinIO.put_object() → Kafka(metadata + object_key))
MINIO_ENABLED=true
MINIO_ENDPOINT=localhost:9000
MINIO_BUCKET=crops
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_SECURE=false

# RTSP
RTSP_USE_FFMPEG_PIPE=true

# Detection: person | face
DETECTION_TYPE=person
PERSON_MODEL_PATH=
PERSON_CONF=0.4
PERSON_IOU=0.5

# Backend fetch timeout (seconds)
BACKEND_CAMERAS_TIMEOUT=10

# FPS
DEFAULT_FPS=2
# CAM1_FPS=2
# CAM2_FPS=1
