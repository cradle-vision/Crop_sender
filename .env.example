# Kafka (overrides config.yaml). Use host:port without http:// (e.g. 64.227.62.36:9092)
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC=snapshots

# Path to cameras list. Local: cameras.yaml. Docker: /app/config/cameras.yaml (file in ./config/)
CAMERAS_CONFIG_PATH=cameras.yaml

# Fetch camera list from backend (GET JSON: { "cameras": [...] } or { "items": [...] }). Auth: Bearer token.
# BACKEND_CAMERAS_URL=http://localhost:8000/api/cameras
# BACKEND_CAMERAS_TOKEN=eyJhbGciOiJIUzI1NiIsInR5cCI6...

# MinIO (optional: upload crops to MinIO, send only bucket+object_key in Kafka)
MINIO_ENABLED=false
MINIO_ENDPOINT=localhost:9000
MINIO_BUCKET=crops
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_SECURE=false

# RTSP
RTSP_USE_FFMPEG_PIPE=true

# Detection: person | face
DETECTION_TYPE=person
PERSON_MODEL_PATH=

# FPS
DEFAULT_FPS=2
# CAM1_FPS=2
# CAM2_FPS=1
