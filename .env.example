# =============================================================================
# Per-store .env — only these keys are required / remotely managed.
# Kafka, MinIO, ROI IPC, streaming delivery/URL/templates, PERSON_* are
# hardcoded defaults in sender + streaming_agent (override via env only if needed).
# =============================================================================

# Cameras from backend (company / building)
BACKEND_CAMERAS_URL=https://api.retailsolution.ai/company/XX/camera/smartcamera/all?page=1&size=20&building_id=YY
BACKEND_TOKEN_URL=https://api.retailsolution.ai/token
BACKEND_CAMERAS_USERNAME=
BACKEND_CAMERAS_PASSWORD=
# Or: BACKEND_CAMERAS_TOKEN=

# Agent identity (unique — from POST /api/stream/agents)
STREAMING_AGENT_ID=cXX-bYY-abc123
STREAMING_AGENT_TOKEN=

# Capture FPS for sender-crop (FFmpeg fps filter). 0 = unlimited.
DEFAULT_FPS=3

# Optional OTA pin
# AGENT_VERSION=latest
# AGENT_IMAGE=ghcr.io/cradle-vision/crop-sender:main
# Private GHCR (org package cannot be Public). One read:packages PAT for the whole fleet.
# Push once via admin apply_env — agents docker-login automatically before pull.
# GHCR_USERNAME=your-github-user
# GHCR_TOKEN=ghp_...

# --- Code defaults (do not put in .env unless overriding) ---
# KAFKA_BOOTSTRAP_SERVERS=64.227.62.36:9092
# KAFKA_TOPIC=snapshots
# MINIO_ENDPOINT=64.227.62.36:9005
# MINIO_BUCKET=visitorstorage
# STREAMING_BACKEND_URL=wss://api.retailsolution.ai/ws/agents
# STREAMING_DELIVERY=upstream_rtmp
# STREAMING_UPSTREAM_RTMP_URL_TEMPLATE=rtmp://64.227.62.36:1935/live/{stream_key}
# STREAMING_UPSTREAM_PLAYBACK_URL_TEMPLATE=https://stream.retailsolution.ai/live/{stream_key}/index.m3u8
# STREAMING_USE_SUBSTREAM=true
# STREAMING_UPSTREAM_TRANSCODE=true
# SENDER_ROI_IPC_ENABLED=true
# SENDER_ROI_SOCKET_PATH=/app/config/sender-roi.sock
# PERSON_CONF=0.4
# PERSON_IOU=0.5
# PROCESSING_WORKERS=4
