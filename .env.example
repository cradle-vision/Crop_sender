# В Docker docker-compose подставляет это в SENDER_KAFKA_BOOTSTRAP_SERVERS.
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC=snapshots

# Cameras: from file (CAMERAS_CONFIG_PATH) or from backend (BACKEND_CAMERAS_URL). If BACKEND_CAMERAS_URL set, list is fetched from API and same host used for snapshot upload.
CAMERAS_CONFIG_PATH=cameras.yaml
BACKEND_CAMERAS_URL=

# Auth for BACKEND_CAMERAS_URL and snapshot upload: Bearer BACKEND_CAMERAS_TOKEN or BACKEND_CAMERAS_USERNAME + BACKEND_CAMERAS_PASSWORD (and BACKEND_TOKEN_URL if needed)
BACKEND_CAMERAS_USERNAME=
BACKEND_CAMERAS_PASSWORD=


MINIO_ENABLED=true
MINIO_ENDPOINT=localhost:9000
MINIO_BUCKET=crops
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_SECURE=false

# RTSP capture reconnect (sender/snapshot_capture_agent.py)
# Socket timeout (microseconds) for RTSP connect/read; uses FFmpeg -timeout (not -stimeout on older builds).
# CAPTURE_RTSP_TIMEOUT_US=5000000
# Force flag: timeout | stimeout | none
# CAPTURE_RTSP_TIMEOUT_FLAG=timeout
# Seconds between reconnect attempts when camera is down (power restored next morning).
# CAPTURE_RECONNECT_SEC=3
# Kill ffmpeg if no full frame within this many seconds (0 = auto from DEFAULT_FPS).
# CAPTURE_FRAME_STALL_SEC=0
# CAPTURE_FFPROBE_TIMEOUT_SEC=8

# Detection: CPU person detection only (person_detect binary + model)
# DETECTION_TYPE removed — only person detection is used
PERSON_MODEL_PATH=
PERSON_CONF=0.4
PERSON_IOU=0.5
# Max subprocess time for one raw-frame detection call (seconds).
PERSON_DETECT_TIMEOUT_SEC=120

# Backend fetch timeout (seconds)
BACKEND_CAMERAS_TIMEOUT=10

# FPS
DEFAULT_FPS=3

# 1/true: log [DEBUG] person hits and periodic no-crop summaries (missed passers). Interval: SENDER_DEBUG_NO_PERSON_INTERVAL_SEC (seconds).
# SENDER_DEBUG=false
# SENDER_DEBUG_NO_PERSON_INTERVAL_SEC=15
# CAM1_FPS=5
# CAM2_FPS=5

# --- Streaming Agent (RTSP → MediaMTX → WebRTC), см. README ---
# Separate container from sender-crop: docker compose --profile streaming up -d
# Config: streaming_agent/streaming-agent.yaml.example + STREAMING_* in .env
# Default: transcode on + camera substream (/Streaming/Channels/102) for live view
# Set to 0/false to disable streaming agent completely (no WS/ffmpeg streaming).
# STREAMING_AGENT_ENABLED=false
# STREAMING_AGENT_CONFIG=config/streaming-agent.yaml
# STREAMING_AGENT_ID=shop-12
# WebSocket listener (путь как у вашего API, напр. /ws/agents)
# STREAMING_BACKEND_URL=wss://your-api.example.com/ws/agents
# api_key из POST /api/stream/agents (scope stream:write) — plain ключ, не старый из другого окружения
# STREAMING_AGENT_TOKEN=
# MEDIAMTX_API_URL=http://127.0.0.1:9997
# MEDIAMTX_PUBLIC_WEBRTC_BASE=http://127.0.0.1:8889
# STREAMING_HEARTBEAT_INTERVAL_SEC=15
# STREAMING_IDLE_GRACE_SEC=10
# 0/false — авто-стоп по зрителям выключен; гасить только по stop_stream
# STREAMING_VIEWER_IDLE_STOP=false
# Режим: local_webrtc | upstream_rtmp | both
# STREAMING_DELIVERY=upstream_rtmp
# STREAMING_UPSTREAM_RTMP_URL_TEMPLATE=rtmp://user:pass@ingest.example.com/live/{stream_key}
# STREAMING_UPSTREAM_PLAYBACK_URL_TEMPLATE=https://watch.example.com/hls/{stream_key}.m3u8
# STREAMING_FFMPEG_PATH=ffmpeg
# Transcode (default true) — libx264 for stable RTMP; use substream to save CPU
# STREAMING_UPSTREAM_TRANSCODE=true
# STREAMING_USE_SUBSTREAM=true
# STREAMING_TRANSCODE_PRESET=ultrafast
# STREAMING_TRANSCODE_MAXRATE=768k
# STREAMING_TRANSCODE_BUFSIZE=1536k
# STREAMING_TRANSCODE_GOP=30
# STREAMING_TRANSCODE_THREADS=0
