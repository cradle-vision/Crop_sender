# Streaming Agent — скопируйте в config/streaming-agent.yaml (или укажите STREAMING_AGENT_CONFIG).
# Секреты: STREAMING_AGENT_TOKEN в .env (не коммитить).
#
# api_key: один раз получить POST /api/stream/agents (scope stream:write), положить в auth_token или env.
# Должен совпадать agent_id с БД; при ротации ключа обновить и перезапустить агента.
# См. docs/streaming_agent_auth.md

# Должен совпадать с агентом, для которого выдали api_key (POST /api/stream/agents)
agent_id: shop-12

backend_url: wss://your-api.example.com/ws/agents

# Plain api_key из ответа POST /api/stream/agents (не JWT от других сервисов)
auth_token: ""

heartbeat_interval_sec: 15.0
reconnect_backoff_initial_sec: 2.0
reconnect_backoff_max_sec: 60.0
idle_grace_sec: 10.0

# true: при viewer_leave с нулём зрителей — отложенная остановка. false: только stop_stream с backend.
viewer_idle_stop: false

# Режим доставки:
# - local_webrtc — только MediaMTX на объекте (WHEP).
# - upstream_rtmp — пуш на центральный RTMP (NAT на объекте не нужен; 200+ агентов).
# - both — оба (две вытяжки с камеры).
delivery: local_webrtc

# Центральный ingest (заполнять при delivery: upstream_rtmp или both)
upstream:
  # Пример: rtmp://USER:PASS@ingest.example.com:1935/live/{stream_key}
  # stream_key = agent_id + "_" + camera_id (см. код make_stream_key)
  rtmp_url_template: ""
  # URL для фронта после транскодинга на сервере (шаблон)
  playback_url_template: ""
  ffmpeg_path: ffmpeg
  ffmpeg_extra_args: []
  # true — libx264 вместо copy (выше CPU), если в логах PTS/DTS invalid / RTP bad cseq при -c copy
  transcode: false

mediamtx:
  api_url: http://127.0.0.1:9997
  public_webrtc_base: http://127.0.0.1:8889
  rtsp_transport: tcp

# Cameras берутся автоматически из `config/cameras.yaml` (env: `CAMERAS_CONFIG_PATH`).
# Поэтому тут секция `cameras:` не требуется.
